# ClipForge AI — Environment Configuration
# Copy to .env and customize as needed.

# ── Server ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# ── Data Storage ───────────────────────────────────────────────────────────────
# Directory for all generated data (relative to project root)
DATA_DIR=./data

# ── Database ───────────────────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///./data/clipforge.db

# ── Whisper Model ──────────────────────────────────────────────────────────────
# Options: tiny, base, small, medium, large-v2, large-v3
# tiny   = fastest, least accurate (~39M params)
# small  = good balance (~244M params) — RECOMMENDED for most machines
# medium = better accuracy, slower (~769M params)
WHISPER_MODEL=small

# Device: cpu or cuda (use cuda if you have an NVIDIA GPU)
WHISPER_DEVICE=cpu

# Compute type: int8 (fast CPU), float16 (GPU), float32 (CPU fallback)
WHISPER_COMPUTE_TYPE=int8

# ── Video Output ───────────────────────────────────────────────────────────────
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
DEFAULT_CLIP_DURATION=30
DEFAULT_NUM_CLIPS=5
DEFAULT_SUBTITLE_STYLE=bold
DEFAULT_ASPECT_RATIO=9:16

# ── Download Quality ───────────────────────────────────────────────────────────
# Keep at 720p to save processing time. Upgrade to 1080p if needed.
# VIDEO_FORMAT=bestvideo[height<=720][ext=mp4]+bestaudio[ext=m4a]/best[height<=720]

# ── Limits ─────────────────────────────────────────────────────────────────────
# Maximum video duration in seconds (3600 = 1 hour)
MAX_VIDEO_DURATION=3600
MAX_CONCURRENT_JOBS=2

# ── Next.js Frontend ───────────────────────────────────────────────────────────
# These are used by the frontend (prefix with NEXT_PUBLIC_ for client-side access)
NEXT_PUBLIC_API_URL=http://localhost:8000
